{
  "name": "@bg-tracker/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/app.ts"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=../../.env src/index.ts | pino-pretty",
    "start": "node src/index.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:check": "scripts/db-check.sh",
    "db:migrate": "node --env-file-if-exists=../../.env scripts/migrate.ts",
    "db:seed": "node --env-file-if-exists=../../.env scripts/seed.ts",
    "bga:import": "node --env-file-if-exists=../../.env scripts/bga-import.ts"
  },
  "dependencies": {
    "@bg-tracker/shared": "workspace:*",
    "@hono/node-server": "2.1.5",
    "@hono/zod-validator": "0.9.1",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.13",
    "pino": "10.4.0",
    "postgres": "3.4.9",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "drizzle-kit": "0.31.11",
    "pino-pretty": "13.2.0"
  }
}
