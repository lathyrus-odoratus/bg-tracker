# 本機開發用。複製成 .env 後填入；.env 不進版控。

# docker compose 的本機 Postgres
DATABASE_URL=postgres://bg:bg@localhost:5434/bg_tracker
# 本機從 Vite 開啟（OAuth redirect 也用這個網址，要登記在 Discord Developer Portal）
APP_URL=http://localhost:5180
# server 的 port；Vite 的 proxy 指向這裡（避開其他專案常用的 3000）
PORT=3180
DISCORD_CLIENT_ID=

# Client Secret 是機密，自己填，不要貼給 agent
DISCORD_CLIENT_SECRET=
# 管理員的 Discord user id，逗號分隔
ADMIN_DISCORD_IDS=

# 選填
# LOG_LEVEL=debug
