{
  "name": "bg-tracker",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,green \"pnpm --filter @bg-tracker/server dev\" \"pnpm --filter @bg-tracker/web dev\"",
    "build": "pnpm --filter @bg-tracker/web build",
    "start": "pnpm --filter @bg-tracker/server start",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @bg-tracker/server db:generate",
    "db:migrate": "pnpm --filter @bg-tracker/server db:migrate",
    "db:seed": "pnpm --filter @bg-tracker/server db:seed"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "concurrently": "10.0.6",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.11.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5"
  }
}
